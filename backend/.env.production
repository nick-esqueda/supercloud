NODE_ENV=production
DB_USERNAME=supercloud
DB_PASSWORD=supercloud
DB_DATABASE=supercloud
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@db:5432/${DB_DATABASE}
JWT_SECRET=
JWT_EXPIRES_IN=604800
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_USERDATA_BUCKET=supercloud-userdata
MEDIA_BASE_URL=https://media.supercloud.nickesqueda.com

# PRODUCTION: CORS SETTINGS
CLIENT_DOMAIN=.supercloud.nickesqueda.com
ALLOWED_ORIGIN=https://supercloud.nickesqueda.com

# PRODUCTION: DB BACKUPS
DB_BACKUP_S3_BUCKET=supercloud.data
